# Configure a senha do seu PostgreSQL. Para teste inicial, use um banco novo chamado lume_teste.
DATABASE_URL="postgresql://postgres:SUA_SENHA_DO_POSTGRES@localhost:5432/lume_teste?schema=public"
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_32_CARACTERES_OU_MAIS"
JWT_EXPIRES_IN="15m"
REFRESH_DAYS=7
PORT=3333
HOST="0.0.0.0"
NODE_ENV="development"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost"
FRONTEND_URL="http://localhost:5173"
TERMS_VERSION="2026-10-09"

# Credenciais locais de exemplo. O seed não altera a senha de um admin existente.
ADMIN_NOME="Administrador LUME"
ADMIN_EMAIL="admin@lume.local"
ADMIN_SENHA="LumeAdmin@123"

# console permite testar recuperação sem e-mail; smtp envia links de recuperação.
EMAIL_MODE="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="seu-email@gmail.com"
SMTP_PASSWORD="senha-de-app-do-provedor"
EMAIL_FROM="LUME <seu-email@gmail.com>"
