        "body": {
          "mode": "raw",
          "raw": "{\n  \"nomeCompleto\": \"Estudante Demo\",\n  \"email\": \"troque@exemplo.org\",\n  \"senha\": \"troque-por-senha-forte-2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) { pm.collectionVariables.set('accessToken', pm.response.json().token); }"
            ]
          }
        }
      ]
